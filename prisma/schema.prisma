datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  PHOTOGRAPHER
  CLIENT
  ADMIN
}

enum EventStatus {
  DRAFT
  PROCESSING
  PUBLISHED
  ARCHIVED
}

enum EventVisibility {
  PUBLIC
  PRIVATE
  UNLISTED
}

enum PhotoStatus {
  UPLOADING
  UPLOADED
  PROCESSING
  READY
  FAILED
  PENDING_APPROVAL
}

model User {
  id           String        @id @default(uuid())
  role         UserRole      @default(PHOTOGRAPHER)
  name         String
  email        String        @unique
  phone        String?
  passwordHash String
  avatarUrl    String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  photographer Photographer?
  sessions     UserSession[]
  loginLogs    LoginLog[]

  @@map("users")
}

model Photographer {
  id                    String         @id @default(uuid())
  userId                String         @unique
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  studioName            String?
  slug                  String         @unique
  city                  String?
  state                 String?
  country               String?        @default("India")
  bio                   String?
  website               String?
  totalStorageUsedBytes BigInt         @default(0)
  activePackageId       String?
  watermarkType         String         @default("NONE") // NONE, TEXT, IMAGE
  watermarkText         String?
  watermarkImageKey     String?
  watermarkPosition     String         @default("CENTER") // CENTER, BOTTOM_RIGHT, TILE
  watermarkOpacity      Int            @default(50) // 10 to 90
  watermarkSize         String         @default("MEDIUM") // SMALL, MEDIUM, LARGE
  studioLogoKey         String?
  studioSubdomain       String?        @unique
  instagramUrl          String?
  facebookUrl           String?
  whatsappPhone         String?
  seoTitle              String?
  seoDescription        String?
  hidePoweredBy         Boolean        @default(false)
  customFooterText      String?
  portfolioEnabled       Boolean        @default(false)
  portfolioTheme         String         @default("ELEGANT") // ELEGANT, MODERN_DARK, BOLD_MINIMAL, VIBRANT
  portfolioHeroTitle     String?
  portfolioHeroSubtitle  String?
  portfolioAboutTitle    String?
  portfolioAboutText     String?
  portfolioAboutImageKey String?
  portfolioAboutImageSizeBytes BigInt         @default(0)
  portfolioMapEmbed      String?
  portfolioPackages      Json?          // Array of pricing packages: [{ name, price, details }]
  portfolioServices      Json?          // Array of services: [{ title, desc, price }]
  portfolioTestimonials  Json?          // Array of testimonials: [{ name, event, text, rating }]
  portfolioStats         Json?          // Milestones: { weddings, experience, clients, photos }
  portfolioFaqs          Json?          // Array of FAQs: [{ question, answer }]
  portfolioVideoUrl      String?        // Video link: YouTube/Vimeo / R2
  portfolioVideoThumbUrl String?        // Poster WebP thumbnail for Hero video
  portfolioVideoSizeBytes BigInt        @default(0)
  portfolioVideoThumbSizeBytes BigInt   @default(0)
  portfolioProcess       Json?          // Array of process steps: [{ step, title, desc }]
  portfolioBtsUrl        String?        // BTS Video (R2 key): {photographerId}/portfolio/bts/video/
  portfolioBtsThumbUrl   String?        // BTS Thumb (R2 key): {photographerId}/portfolio/bts/thumb/
  portfolioBtsSizeBytes  BigInt         @default(0)
  portfolioBtsThumbSizeBytes BigInt     @default(0)
  portfolioEquipment     Json?          // Array of gear: [{ category, items }]
  portfolioDestinations  Json?          // Array of cities/destinations covered: [string]
  portfolioBookingPolicy String?        // Booking terms & conditions text
  portfolioPress         Json?          // Array of press/publications: [string]
  portfolioStyles        Json?          // Array of signature styles: [{ title, desc }]
  portfolioPhone         String?        // Studio phone for portfolio contact page
  portfolioEmail         String?        // Studio email for portfolio contact page
  portfolioAddress       String?        // Studio office address for portfolio contact page
  portfolioWhatsapp      String?        // Studio WhatsApp number for portfolio contact page
  portfolioPhotos        PortfolioPhoto[] // Portfolio Showcase Photos
  portfolioReels         PortfolioReel[]  // Dedicated Portfolio Reel Videos
  portfolioInquiries    PortfolioInquiry[] // Client Leads / Inquiries from portfolio website
  portfolioReviews      PortfolioReview[]  // Client Reviews from portfolio website
  businessCard          BusinessCard?
  googleDriveAccessToken     String?
  googleDriveRefreshToken    String?
  googleDriveConnected       Boolean        @default(false)
  autoBackupToDrive          Boolean        @default(false)  // Auto backup all events to Google Drive
  driveBackupFullNotified    Boolean        @default(false)  // Drive full notification sent
  beamFtpPhotosUsedThisMonth Int            @default(0)      // Permanent monthly Beam FTP uploaded photos count
  beamFtpVideosUsedThisMonth Int            @default(0)      // Permanent monthly Beam FTP uploaded videos count
  beamFtpPhotosBillingCycle  String?                         // Billing month tag e.g. "2026_09" for automatic reset
  creditBalance              Int            @default(0) // credit balance in Paise (10 paise per photo, 50 paise per video minute)
  walletCashBalance          Int            @default(0) // Permanent Studio Cash balance in Paise (Never expires, usable on checkout)
  referralCode               String?        @unique
  referredById               String?
  referredBy                 Photographer?  @relation("PhotographerReferrals", fields: [referredById], references: [id])
  referredPhotographers      Photographer[] @relation("PhotographerReferrals")
  referralsMade              Referral[]     @relation("ReferralsMade")
  referralReceived           Referral?      @relation("ReferralReceived")
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  creditTransactions    CreditTransaction[]
  walletCashTransactions WalletCashTransaction[]
  subscriptions         Subscription[]
  paymentOrders         PaymentOrder[]
  events                Event[]
  photos                Photo[]
  embeddings            FaceEmbedding[]
  uploadBatches         UploadBatch[]
  promoCodeUsages       PromoCodeUsage[]

  @@map("photographers")
}


model Package {
  id                          String         @id @default(uuid())
  name                        String         @unique
  maxStorageGb                Int
  maxEventsStorageMb          Int            @default(200)   // Event media limit in MB
  maxPortfolioStorageMb       Int            @default(0)     // Portfolio & Branding limit in MB
  price                       Int            // price in paisa or local currency
  faceScanCredits             Int            @default(0)     // AI credit added monthly in Paise
  isActive                    Boolean        @default(true)
  
  // GRANULAR FEATURE FLAGS
  featureAiPhotoSearch        Boolean        @default(false)
  featureAiVideoSearch        Boolean        @default(false)
  featureCustomBranding       Boolean        @default(false)
  featureClientSelection      Boolean        @default(false)
  featureGuestUpload          Boolean        @default(false)
  featurePortfolioWebsite     Boolean        @default(false)
  featureDigitalBusinessCard  Boolean        @default(false)
  featureAutoDriveBackup      Boolean        @default(false)
  featureDisableDownload      Boolean        @default(false)
  featureWatermark            Boolean        @default(false)
  featureBeamLiveCamera       Boolean        @default(false)
  featureBulkDownload         Boolean        @default(false)
  maxBeamFtpPhotos            Int            @default(0)     // Monthly Beam FTP photos limit (0 = disabled, e.g. 5000)
  maxBeamFtpVideos            Int            @default(0)     // Monthly Beam FTP video limit (0 = disabled, e.g. 50)
  maxConcurrentCameras        Int            @default(0)     // Max simultaneous active cameras across studio (0 = disabled, e.g. 1, 2)

  // MULTI-YEAR & 2-CATEGORY DISCOUNT PERCENTAGES
  firstTimeDiscount1Yr        Int            @default(0)     // First-time buyer 1-Year %
  firstTimeDiscount2Yr        Int            @default(15)    // First-time buyer 2-Year %
  firstTimeDiscount3Yr        Int            @default(30)    // First-time buyer 3-Year %
  standardDiscount1Yr         Int            @default(0)     // Regular/Existing buyer 1-Year %
  standardDiscount2Yr         Int            @default(10)    // Regular/Existing buyer 2-Year %
  standardDiscount3Yr         Int            @default(20)    // Regular/Existing buyer 3-Year %
  tax                         Int            @default(18)    // Total Tax & Gateway % combined (e.g. 18%)

  subscriptions               Subscription[]
  paymentOrders               PaymentOrder[]
  referrals                   Referral[]
  referralConfig              ReferralConfig?

  @@map("packages")
}

model AiCreditPack {
  id              String         @id @default(uuid())
  name            String         // e.g. "Standard Pack", "Pro Studio Pack", "Mega Wedding Pack"
  price           Int            // in Paise (e.g. 50000 = ₹500)
  creditsGiven    Int            // in Paise worth of AI credits (e.g. 50000 = ₹500)
  photosEstimate  String         @default("~5,000 Photos Scan")
  discountPercent Int            @default(0) // % discount (e.g. 10)
  tax             Int            @default(18) // Tax % (e.g. 18)
  badge           String?        @default("Popular") // e.g. "Basic", "Best Value", "Mega Weddings"
  isPopular       Boolean        @default(false)
  isActive        Boolean        @default(true)
  sortOrder       Int            @default(0)
  paymentOrders   PaymentOrder[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("ai_credit_packs")
}

model PaymentOrder {
  id                String        @id @default(uuid())
  photographerId    String
  photographer      Photographer  @relation(fields: [photographerId], references: [id], onDelete: Cascade)
  packageId         String?
  package           Package?      @relation(fields: [packageId], references: [id])
  creditPackId      String?
  creditPack        AiCreditPack? @relation(fields: [creditPackId], references: [id])
  
  orderType         String        @default("SUBSCRIPTION") // SUBSCRIPTION, CREDIT_TOPUP
  razorpayOrderId   String        @unique
  razorpayPaymentId String?       @unique
  razorpaySignature String?
  
  subtotalAmount    Int?          @default(0) // In Paise before tax
  taxAmount         Int?          @default(0) // In Paise
  amount            Int           // In Paise (Final total paid)
  creditsGiven      Int?          @default(0) // In Paise for CREDIT_TOPUP
  currency          String        @default("INR")
  status            String        @default("PENDING") // PENDING, SUCCESS, FAILED
  billingInterval   String?       @default("YEARLY")
  
  yearsCount        Int?          // 1, 2, or 3 Years for SUBSCRIPTION, null for CREDIT_TOPUP
  isFirstTime       Boolean       @default(false)
  discountPercent   Int           @default(0)
  discountAmount    Int           @default(0) // In Paise

  promoCodeId         String?
  promoCode           PromoCode?    @relation(fields: [promoCodeId], references: [id])
  promoCodeText       String?
  promoDiscountAmount Int?          @default(0) // In Paise
  walletCashUsedAmount Int?         @default(0) // In Paise (Studio Wallet Cash redeemed)

  invoiceNumber     String?       @unique // e.g. FSG-2026-0001
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([photographerId, status])
  @@map("payment_orders")
}

model Subscription {
  id                  String       @id @default(uuid())
  photographerId      String
  photographer        Photographer @relation(fields: [photographerId], references: [id], onDelete: Cascade)
  packageId           String
  package             Package      @relation(fields: [packageId], references: [id])
  startsAt            DateTime     @default(now())
  endsAt              DateTime
  status              String       // ACTIVE, EXPIRED, CANCELLED
  yearsCount          Int          @default(1)
  amountPaid          Int?         @default(0) // In Paise
  limitBytes          BigInt       @default(5242880000)
  limitEventsBytes    BigInt       @default(5242880000)
  limitPortfolioBytes BigInt       @default(0)
  usedBytes           BigInt       @default(0)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([photographerId, status])
  @@map("subscriptions")
}

model Event {
  id                    String            @id @default(uuid())
  photographerId        String
  photographer          Photographer      @relation(fields: [photographerId], references: [id], onDelete: Cascade)
  title                 String
  slug                  String            @unique
  eventDate             DateTime?
  location              String?
  status                EventStatus       @default(DRAFT)
  visibility            EventVisibility   @default(PRIVATE)
  allowDownload         Boolean           @default(true)
  allowFavorites        Boolean           @default(false)
  faceSearchEnabled     Boolean           @default(true)
  faceScanningEnabled   Boolean           @default(false)
  videoScanningEnabled  Boolean           @default(false)
  passcode              String?           @default("1234")
  maxFavorites          Int               @default(0) // 0 means unlimited selection
  watermarkEnabled      Boolean           @default(false)
  themeKey              String            @default("CLASSIC_LIGHT")
  applyThemeToClientGallery Boolean       @default(false)
  allowGuestUploads     Boolean           @default(false)
  maxGuestUploadFiles   Int               @default(500)
  maxGuestUploadStorage BigInt            @default(524288000) // 500 MB in Bytes
  beamEnabled           Boolean           @default(false)
  beamUploadMode        String            @default("PHOTOS_ONLY")
  beamExpiresAt         DateTime?
  ftpUsername           String?           @unique
  ftpPassword           String?
  lastCameraConnectedAt DateTime?
  lastCameraModel       String?
  isDeleted             Boolean           @default(false)
  deletedAt             DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  photos                Photo[]
  embeddings            FaceEmbedding[]
  uploadBatches         UploadBatch[]
  favorites             FavoritePhoto[]

  @@index([photographerId, isDeleted])
  @@map("events")
}


model UploadBatch {
  id             String       @id @default(uuid())
  eventId        String
  event          Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  photographerId String
  photographer   Photographer @relation(fields: [photographerId], references: [id], onDelete: Cascade)
  totalFiles     Int
  uploadedFiles  Int          @default(0)
  processedFiles Int          @default(0)
  failedFiles    Int          @default(0)
  status         String       // PENDING, COMPLETED, PROCESSING
  createdAt      DateTime     @default(now())
  photos         Photo[]

  @@map("upload_batches")
}

model Photo {
  id               String              @id @default(uuid())
  eventId          String
  event            Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  photographerId   String
  photographer     Photographer        @relation(fields: [photographerId], references: [id], onDelete: Cascade)
  uploadBatchId    String?
  uploadBatch      UploadBatch?        @relation(fields: [uploadBatchId], references: [id], onDelete: SetNull)
  filenameOriginal String
  filenameStored   String
  r2KeyOriginal    String
  r2KeyPreview     String?
  r2KeyThumb       String?
  mimeType         String
  fileSize         BigInt
  thumbSizeBytes   BigInt              @default(0)
  previewSizeBytes BigInt              @default(0)
  status           PhotoStatus         @default(UPLOADING)
  thumbnailStatus  String              @default("PENDING")
  faceScanStatus   String              @default("PENDING")
  type             String              @default("IMAGE")
  thumbnailUrl     String?
  cameraModel      String?
  duration         Float?
  hasFaces         Boolean             @default(false)
  faceCount        Int                 @default(0)
  isDeleted        Boolean             @default(false)
  deletedAt        DateTime?
  uploadSource     String              @default("WEB") // "FTP_BEAM", "WEB", "GUEST_QR"
  isGuestUpload    Boolean             @default(false)
  backedUpToDrive  Boolean             @default(false)  // Has been uploaded to Google Drive
  driveFileId      String?                               // Google Drive file ID reference
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  embeddings       FaceEmbedding[]
  favorites        FavoritePhoto[]

  @@map("photos")
  @@index([eventId])
  @@index([uploadBatchId])
  @@index([photographerId])
  @@index([photographerId, isDeleted])
  @@index([eventId, status, isDeleted, createdAt(sort: Desc)])
}

model FaceEmbedding {
  id             String       @id @default(uuid())
  photoId        String
  photo          Photo        @relation(fields: [photoId], references: [id], onDelete: Cascade)
  eventId        String
  event          Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  photographerId String
  photographer   Photographer @relation(fields: [photographerId], references: [id], onDelete: Cascade)
  faceIndex      Int
  bboxX          Float
  bboxY          Float
  bboxW          Float
  bboxH          Float
  confidence     Float
  embedding      Unsupported("vector(512)")
  clusterId      String?      // Links confirmed face groups together persistently
  timestamp      Float?
  createdAt      DateTime     @default(now())

  @@index([eventId])
  @@index([photographerId])
  @@index([photoId])
  @@index([clusterId])
  @@index([eventId, photographerId])
  @@map("face_embeddings")
}



model UserSession {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  userAgent String?
  ipAddress String?
  device    String?  // Desktop, Phone
  browser   String?
  os        String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("user_sessions")
}

model LoginLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String?
  userAgent String?
  device    String?
  browser   String?
  os        String?
  status    String   // SUCCESS, FAILED
  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@map("login_logs")
}

model FavoritePhoto {
  id              String   @id @default(uuid())
  photoId         String
  photo           Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  eventId         String
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  clientSessionId String   // Group key (device session or unified shared selection)
  createdAt       DateTime @default(now())

  @@unique([photoId, clientSessionId])
  @@index([eventId, clientSessionId])
  @@map("favorite_photos")
}

model PortfolioPhoto {
  id             String       @id @default(uuid())
  photographerId String
  photographer   Photographer @relation(fields: [photographerId], references: [id], onDelete: Cascade)
  r2KeyOriginal  String
  r2KeyThumb     String
  fileSize       BigInt       @default(0)
  thumbSizeBytes BigInt       @default(0)
  category       String       @default("General")
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())

  @@index([photographerId, sortOrder])
  @@map("portfolio_photos")
}

model PortfolioInquiry {
  id             String       @id @default(uuid())
  photographerId String
  photographer   Photographer @relation(fields: [photographerId], references: [id], onDelete: Cascade)
  clientName     String
  clientEmail    String
  clientPhone    String
  eventDate      String?
  message        String
  createdAt      DateTime     @default(now())

  @@index([photographerId, createdAt(sort: Desc)])
  @@map("portfolio_inquiries")
}

model PortfolioReview {
  id             String       @id @default(uuid())
  photographerId String
  photographer   Photographer @relation(fields: [photographerId], references: [id], onDelete: Cascade)
  clientName     String
  clientRole     String?      // e.g. "Bride", "Groom", "Wedding Guest"
  rating         Int          // 1-5 stars
  comment        String
  isApproved     Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([photographerId, isApproved])
  @@map("portfolio_reviews")
}

model PortfolioTheme {
  id            String   @id @default(uuid())
  key           String   @unique
  name          String
  description   String?
  previewBg     String   @default("bg-slate-900")
  componentName String?
  isActive      Boolean  @default(true)
  isDefault     Boolean  @default(false)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("portfolio_themes")
}

model CardTheme {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  badgeText   String?
  previewBg   String   @default("from-amber-200 to-yellow-500")
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("card_themes")
}


model BusinessCard {
  id             String       @id @default(uuid())
  photographerId String       @unique
  photographer   Photographer @relation(fields: [photographerId], references: [id], onDelete: Cascade)
  slug           String       @unique
  theme          String       @default("ROYAL_GOLD") // ROYAL_GOLD, MATTE_DARK, NEON_GLASS, MINIMAL_WHITE
  displayName    String?
  jobTitle       String?      @default("Professional Wedding & Event Photographer")
  tagline        String?
  bio            String?
  phone          String?
  whatsapp       String?
  email          String?
  website        String?
  city           String?
  instagram      String?
  facebook       String?
  youtube        String?
  address        String?
  customLinks    Json?        // Array: [{ label, url }]
  viewsCount     Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("business_cards")
}


model CreditTransaction {
  id             String       @id @default(uuid())
  photographerId String
  photographer   Photographer @relation(fields: [photographerId], references: [id], onDelete: Cascade)
  amount         Int          // amount in Paise (+ve for add, -ve for deduct)
  action         String       // PHOTO_SCAN, VIDEO_SCAN, ADMIN_ADD, ADMIN_SET, PLAN_BENEFIT, MONTHLY_RENEW
  description    String?
  createdAt      DateTime     @default(now())

  @@map("credit_transactions")
  @@index([photographerId])
}

model PortfolioReel {
  id             String       @id @default(uuid())
  photographerId String
  photographer   Photographer @relation(fields: [photographerId], references: [id], onDelete: Cascade)
  title          String
  r2Key          String
  r2KeyThumb     String?
  fileSize       BigInt       @default(0)
  thumbSizeBytes BigInt       @default(0)
  category       String?      @default("Highlights")
  duration       Int?
  viewsCount     Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("portfolio_reels")
  @@index([photographerId])
  @@index([photographerId, createdAt(sort: Desc)])
}

model PlanInquiry {
  id               String    @id @default(uuid())
  photographerId   String?
  photographerName String?
  email            String?
  phone            String?
  interestedIn     String
  eventDate        String?
  requirements     String?   @db.Text
  status           String    @default("PENDING") // PENDING, CONTACTED, CONVERTED, CLOSED
  source           String    @default("UPGRADE_PAGE")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("plan_inquiries")
  @@index([createdAt(sort: Desc)])
  @@index([status])
  @@index([photographerId])
}

enum PromoDiscountType {
  PERCENTAGE
  FLAT
}

enum PromoApplicableScope {
  ALL
  SUBSCRIPTION
  AI_CREDITS
}

model PromoCode {
  id                String               @id @default(uuid())
  code              String               @unique // e.g. "SAVE20", "DIWALI500", uppercase
  discountType      PromoDiscountType    @default(PERCENTAGE)
  discountValue     Float                // e.g. 20 (for 20%) or 500 (for ₹500 flat)
  maxDiscountRupees Float?               // Cap in Rupees for PERCENTAGE discount, e.g. Max ₹2000 off
  minOrderRupees    Float?               @default(0) // Minimum cart subtotal in Rupees to apply
  applicableScope   PromoApplicableScope @default(ALL) // ALL, SUBSCRIPTION, AI_CREDITS
  
  // USAGE LIMITS
  maxUsesTotal      Int                  @default(100) // Total lifetime redemptions allowed across all users
  usedCount         Int                  @default(0)   // Total times successfully redeemed
  maxUsesPerUser    Int                  @default(1)   // Max times a single photographer can redeem (default 1)
  
  // USER-SPECIFIC TARGETING
  isUserSpecific    Boolean              @default(false)
  allowedEmails     String?              // Comma-separated emails, e.g. "ajay2@gmail.com, sahil@fotosetgo.com"
  allowedPhones     String?              // Comma-separated phone numbers
  
  validFrom         DateTime             @default(now())
  validUntil        DateTime?            // Optional expiry date
  isActive          Boolean              @default(true)
  
  description       String?              // Internal admin note e.g. "Diwali 2026 Special for Premium Studios"
  
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  usages            PromoCodeUsage[]
  paymentOrders     PaymentOrder[]

  @@map("promo_codes")
  @@index([code])
  @@index([isActive])
}

model PromoCodeUsage {
  id                  String        @id @default(uuid())
  promoCodeId         String
  promoCode           PromoCode     @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  photographerId      String
  photographer        Photographer  @relation(fields: [photographerId], references: [id], onDelete: Cascade)
  paymentOrderId      String?
  discountAmountPaise Int           // Discount in Paise
  orderType           String        // SUBSCRIPTION or CREDIT_TOPUP
  usedAt              DateTime      @default(now())

  @@map("promo_code_usages")
  @@index([promoCodeId])
  @@index([photographerId])
  @@index([promoCodeId, photographerId])
}

model Referral {
  id                     String        @id @default(uuid())
  referrerId             String
  referrer               Photographer  @relation("ReferralsMade", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUserId         String        @unique
  referredUser           Photographer  @relation("ReferralReceived", fields: [referredUserId], references: [id], onDelete: Cascade)
  packageId              String
  package                Package       @relation(fields: [packageId], references: [id])
  tenureYears            Int           @default(1)
  instantCreditsAwarded  Int           @default(0) // in Paise
  monthlyBoostCredits    Int           @default(0) // in Paise
  status                 String        @default("ACTIVE") // ACTIVE, EXPIRED, PAUSED, CANCELLED
  validFrom              DateTime      @default(now())
  validUntil             DateTime
  initialPaymentOrderId  String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  @@map("referrals")
  @@index([referrerId, status])
  @@index([referredUserId])
}

model ReferralConfig {
  id                     String        @id @default(uuid())
  packageId              String        @unique
  package                Package       @relation(fields: [packageId], references: [id], onDelete: Cascade)
  isReferralEnabled      Boolean       @default(true)
  instantBonusCredits    Int           @default(0) // in Paise (e.g. 20000 = ₹200)
  monthlyBoostCredits    Int           @default(0) // in Paise (e.g. 20000 = ₹200/mo)
  refereeWelcomeCredits  Int           @default(5000) // in Paise (e.g. 5000 = ₹50 for the new user)
  updatedAt              DateTime      @updatedAt

  @@map("referral_configs")
}

model WalletConfig {
  id                  String   @id @default(uuid())
  creditsPerRupee     Int      @default(5)   // e.g. 5 AI Credits = ₹1 Studio Cash
  minCreditsToConvert Int      @default(250) // Minimum AI credits needed to convert (e.g. 250 credits)
  isConversionEnabled Boolean  @default(true)
  cashBackPercent     Int      @default(0)   // Optional cashback on purchase (%)
  updatedAt           DateTime @updatedAt

  @@map("wallet_configs")
}

model WalletCashTransaction {
  id             String       @id @default(uuid())
  photographerId String
  photographer   Photographer @relation(fields: [photographerId], references: [id], onDelete: Cascade)
  amount         Int          // amount in Paise (+ve for credit/addition, -ve for debit/spend)
  action         String       // LIQUIDATION_CONVERT, SUBSCRIPTION_PAYMENT, CREDIT_TOPUP_PAYMENT, ADMIN_CREDIT, ADMIN_DEBIT, REFUND
  description    String?
  creditsDebited Int?         @default(0) // AI Credits liquidated (if action is LIQUIDATION_CONVERT)
  paymentOrderId String?      // Linked payment order if spent on checkout
  createdAt      DateTime     @default(now())

  @@map("wallet_cash_transactions")
  @@index([photographerId])
  @@index([photographerId, createdAt(sort: Desc)])
}



